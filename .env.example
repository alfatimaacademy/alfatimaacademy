# Server-side only (Vercel -> Settings -> Environment Variables). Never put this in chatbot-widget.js
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL. Leave it out to use the built-in default model list.
# If set, it REPLACES the default list (comma separated, tried in order).
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
